[Unit]
Description=Gunicorn daemon for DCRM service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
Environment=LANG=zh_CN.UTF-8
Environment=LC_ALL=zh_CN.UTF-8
Environment=LC_LANG=zh_CN.UTF-8
Environment=DJANGO_SETTINGS_MODULE=idcops.settings
WorkingDirectory=/opt/idcops/
ExecStart=/opt/idcops/.venv/bin/gunicorn -c contrib/gunicorn.py

Restart=on-failure
RestartSec=30
PrivateTmp=true

[Install]
WantedBy=multi-user.target
