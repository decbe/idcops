[Unit]
Description=RQ Worker Number %i For DCRM
After=network.target

[Service]
Type=simple
User=root
Group=root
Environment=LANG=zh_CN.UTF-8
Environment=LC_ALL=zh_CN.UTF-8
Environment=LC_LANG=zh_CN.UTF-8
Environment=DJANGO_SETTINGS_MODULE=idcops.settings
WorkingDirectory=/opt/idcops/
ExecStart=/opt/idcops/.venv/bin/python manage.py rqworker high default low --with-scheduler
ExecReload=/bin/kill -s HUP $MAINPID
ExecStop=/bin/kill -s TERM $MAINPID
PrivateTmp=true
Restart=always

[Install]
WantedBy=multi-user.target