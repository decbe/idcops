# ============================================================================
# IDCOPS 环境变量配置示例
# ============================================================================
# 复制此文件为 .env 并根据实际情况修改配置
# cp .env.example .env
#
# 注意：此文件用于开发环境，Docker 部署请参考 .env.docker
# ============================================================================

# ----------------------------------------------------------------------------
# Django 核心配置
# ----------------------------------------------------------------------------

# Django 密钥（必须修改！）
# 使用 generate_secret_key.py 生成新的密钥
SECRET_KEY=your-secret-key-here-change-this-in-production

# 调试模式（生产环境必须设为 0）
# 0 = False, 1 = True
DEBUG=1

# 开发环境标识（用于启用开发工具）
# 0 = False, 1 = True
DEV_ENV=1

# 允许的主机（逗号分隔）
# 生产环境必须设置实际域名
ALLOWED_HOSTS=.localhost,127.0.0.1,localhost

# CSRF 信任的源（逗号分隔）
# 生产环境必须设置实际域名
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# 时区设置
TIME_ZONE=Asia/Shanghai

# 站点 URL 前缀（用于子路径部署，如 /idcops/）
# 默认 / 表示根路径
SITE_PREFIX=/

# 启用 Django Debug Toolbar（仅开发环境）
# 0 = False, 1 = True
ENABLE_DEBUG_TOOLBAR=0

# ----------------------------------------------------------------------------
# 数据库配置（PostgreSQL）
# ----------------------------------------------------------------------------

POSTGRES_DB=dcrm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ----------------------------------------------------------------------------
# Redis 配置
# ----------------------------------------------------------------------------

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# Redis 认证（如果 Redis 设置了密码）
# REDIS_USER=
# REDIS_PASSWORD=

# ----------------------------------------------------------------------------
# Gunicorn 配置
# ----------------------------------------------------------------------------

# Gunicorn 监听端口
GUNICORN_PORT=8000

# Gunicorn 工作进程数
# 建议值：CPU 核心数 * 2 + 1
GUNICORN_WORKERS=1

# Gunicorn 请求超时时间（秒）
GUNICORN_TIMEOUT=120

# ----------------------------------------------------------------------------
# Nginx 配置（非 Docker 部署时使用）
# ----------------------------------------------------------------------------

# Nginx 监听端口
NGINX_PORT=80

# Nginx 服务器名称
NGINX_SERVER_NAME=localhost

# Nginx 客户端最大请求体大小
NGINX_CLIENT_MAX_BODY_SIZE=100m

# Nginx 上游服务器主机（可选，默认：127.0.0.1）
# 在 Docker 环境中通常为 "web"
NGINX_UPSTREAM_HOST=127.0.0.1

# Nginx 上游服务器端口（可选，默认：使用 GUNICORN_PORT）
# 如果未设置，将自动使用 GUNICORN_PORT 的值
# NGINX_UPSTREAM_PORT=8000

# 应用主目录（用于生成静态文件和媒体文件路径）
APP_HOME=/opt/idcops

# Nginx 静态文件路径（可选，默认：${APP_HOME}/static/）
# 如果未设置，将自动基于 APP_HOME 生成
# NGINX_STATIC_PATH=/opt/idcops/static/

# Nginx 媒体文件路径（可选，默认：${APP_HOME}/media/）
# 如果未设置，将自动基于 APP_HOME 生成
# NGINX_MEDIA_PATH=/opt/idcops/media/

# ----------------------------------------------------------------------------
# 会话配置
# ----------------------------------------------------------------------------

# 会话存储引擎类型（db, cache, file）
SESSION_ENGINE_TYPE=db

# 会话 Cookie 安全设置（HTTPS 环境设为 1）
SESSION_COOKIE_SECURE=0

# CSRF Cookie 安全设置（HTTPS 环境设为 1）
CSRF_COOKIE_SECURE=0

# ----------------------------------------------------------------------------
# 日志配置
# ----------------------------------------------------------------------------

# 日志文件最大大小（字节），默认 10MB
LOG_MAX_BYTES=10485760

# 日志文件备份数量
LOG_BACKUP_COUNT=10

# ----------------------------------------------------------------------------
# 机器学习模型配置（可选）
# ----------------------------------------------------------------------------

# 是否预加载设备型号预测模型
# 0 = False, 1 = True
PRELOAD_DEVICE_ML_MODEL=0

# 文档分类器模型路径（可选）
# DOC_CLASSIFIER_MODEL_PATH=/opt/idcops/media/ml/document_classifier.pickle

# ----------------------------------------------------------------------------
# OCR 配置（可选）
# ----------------------------------------------------------------------------

# OCR 代理（baidu_ocr 等）
OCR_AGENT=baidu_ocr

# 百度 OCR API 配置（可选）
# BDOCR_APPID=
# BDOCR_API_KEY=
# BDOCR_SECERT_KEY=

# ----------------------------------------------------------------------------
# InfluxDB 配置（可选）
# ----------------------------------------------------------------------------

# InfluxDB URI
# INFLUXDB_URI=http://127.0.0.1:8086

# InfluxDB 组织
# INFLUXDB_ORG=dcrm

# InfluxDB 访问令牌
# INFLUXDB_TOKEN=

# ----------------------------------------------------------------------------
# 任务调度配置（可选）
# ----------------------------------------------------------------------------

# 自动修复缓存计数时间间隔（秒），默认 30 分钟
# AUTOFIX_CACHE_COUNT_INTERVAL=1800

# 训练设备模型时间间隔（秒），默认 12 小时
# TRAIN_DEVICE_MODEL_INTERVAL=43200

# 训练文档分类器时间间隔（秒），默认 12 小时
# TRAIN_DOCUMENT_CLASSIFIER_INTERVAL=43200

# ----------------------------------------------------------------------------
# 统计和监控配置（可选）
# ----------------------------------------------------------------------------

# 是否启用匿名使用情况上报（默认开启）
# 0 = False, 1 = True
CENSUS_REPORTING_ENABLED=1

# 离线部署模式（跳过所有外部网络请求）
# 0 = False, 1 = True
ISOLATED_DEPLOYMENT=0

# ----------------------------------------------------------------------------
# Django 设置模块（通常不需要修改）
# ----------------------------------------------------------------------------

DJANGO_SETTINGS_MODULE=idcops.settings
