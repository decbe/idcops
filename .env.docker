# ===========================================
# Docker 环境变量配置文件
# 复制此文件为 .env 并根据实际情况修改
# ===========================================

# 应用版本
VERSION=latest

# ===========================================
# 应用程序基本设置
# ===========================================
DEBUG=0
ENABLE_DEBUG_TOOLBAR=0
DEV_ENV=0

# Django 密钥（必须修改！）
SECRET_KEY=

DJANGO_SETTINGS_MODULE=idcops.settings

# 会话引擎类型: db, cache, file, cached_db, signed_cookies
SESSION_ENGINE_TYPE=cache

# ===========================================
# 安全相关
# ===========================================
ALLOWED_HOSTS=*

CSRF_TRUSTED_ORIGINS=https://*,http://*

SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0

# ===========================================
# 本地化相关
# ===========================================
TIME_ZONE=Asia/Shanghai

# ===========================================
# 应用程序路径（容器内路径）
# ===========================================
APP_HOME=/opt/idcops
APP_USER=dcrm
APP_GROUP=dcrm

# 应用程序请求相关
USE_X_FORWARDED_HOST=0

# ===========================================
# Gunicorn 设置
# ===========================================
GUNICORN_PORT=8000
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120
GUNICORN_RELOAD=0

# ===========================================
# Redis 配置（Docker 内部服务）
# ===========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# ===========================================
# PostgreSQL 数据库配置（Docker 内部服务）
# ===========================================
POSTGRES_HOST=postgresql
POSTGRES_PORT=5432
POSTGRES_DB=dcrm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ===========================================
# 百度 OCR 配置（留空则禁用）
# ===========================================
OCR_AGENT=baidu_ocr
BDOCR_APPID=
BDOCR_API_KEY=
BDOCR_SECERT_KEY=

# ===========================================
# Nginx Web 服务器设置
# ===========================================
NGINX_HOST=0.0.0.0
NGINX_PORT=80
NGINX_SERVER_NAME=localhost
NGINX_CLIENT_MAX_BODY_SIZE=100m
NGINX_UPSTREAM_HOST=web
NGINX_UPSTREAM_PORT=8000

# 静态文件路径（容器内路径）
NGINX_STATIC_PATH=/opt/idcops/static/
NGINX_MEDIA_PATH=/opt/idcops/media/

# ===========================================
# 日志配置
# ===========================================
LOG_LEVEL=INFO
LOG_FILE=/opt/idcops/logs/dcrm.log
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=5

# ===========================================
# 基本配置
# ===========================================
APP_URL=http://localhost
SITE_PREFIX=/

# ===========================================
# InfluxDB 配置（可选）
# ===========================================
INFLUXDB_URI=
INFLUXDB_TOKEN=
INFLUXDB_ORG=

# ===========================================
# 飞书群机器人（可选）
# ===========================================
FS_WEBHOOK=
FS_SIGN=

# ===========================================
# 数据库等待超时（秒）
# ===========================================
DB_WAIT_TIMEOUT=60
